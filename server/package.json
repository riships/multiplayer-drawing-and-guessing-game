{
  "name": "pictionary-server",
  "version": "1.0.0",
  "description": "Express + Socket.IO Backend for Multiplayer Pictionary",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/test/index.test.js",
    "test:coverage": "node --test --experimental-test-coverage dist/test/index.test.js",
    "test:stress": "npx tsx scripts/stress-test.ts",
    "start": "node dist/server.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start:prod": "node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "socket.io-client": "^4.8.4",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
